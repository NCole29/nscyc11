{# image is above content for mobile screens and to left otherwise #}
<article class="two-column-card">
  <div class="column image-column">
      {% if image %}
        {{ image}}
      {% endif %}
  </div>  

  <div class="column text-column">
      <h2 class="card-title">{{ heading }}</h2>
      {% if date %}
        {{ date }}
      {% endif %}
      {% if location %}
        {{ location }}
      {% endif %}
      {{ content }}
      <div class="card-more">
        {{ link }}
      </div>
  </div>
</article>
