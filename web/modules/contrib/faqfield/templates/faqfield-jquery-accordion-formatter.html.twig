{#
/**
 * @file
 * Default theme implementation of a FAQ Field accordion formatter.
 *
 * Available variables:
 * - items: An array of objects with the following fields.
 *   - question: Pre-filtered question value by check_plain.
 *   - answer: Pre-filtered answer value by field setting format.
 * - id: Id to wrap the accordion markup in.
 *
 * @see template_preprocess()
 * @see template_preprocess_faqfield_jquery_accordion_formatter()
 *
 * @ingroup themeable
 */
#}
{% set tag = question_tag ?: 'h3' %}
{% apply spaceless %}
  <div id="{{ id }}">
    {% for item in items %}
      <{{ tag }} class="faqfield-question">{{ item.question }}</{{ tag }}>
      <div class="faqfield-answer">{{ item.answer }}</div>
    {% endfor %}
  </div>
{% endapply %}
