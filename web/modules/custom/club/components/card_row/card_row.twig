{# image is above content for mobile screens and to left otherwise #}
<article class="card-row">
  <div class="card-row-container">
    {% if image %}
      <div>
        {{ image}}
      </div>
    {% endif %}
    <div class="card-content">
     <h2 class="card-title"><a href="{{ url }}">{{ heading }}</a></h2>
      {% if date %}
        {{ date }}
      {% endif %}
      {% if location %}
        <p>{{ location }}</p>
      {% endif %}

      {{ content }}
    </div>
    <div class="card-more">
      {{ link }}
    </div>
  </div>
</article>
