{#
/**
 * @file
 * NSC: Display location address on a card (view mode = card)
 *  with the location name displayed as a field label not a node title and no link.
 * 
 */
#}

{% set classes = [
    'solo-clear',
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <div{{ content_attributes.addClass('solo-clear') }}>
    Location:<strong>{{ label }}</strong>  {{ content|without('field_google_map') }}
  </div>
</article>
