{#  pcard.twig is "included" in nsctheme/templates/paragraphs/paragraph--card.html.twig
    which must be modified if fields are added.
 #}

{% set styled_media = {
  '#theme': 'image_style',
  '#style_name': 'large_4_3',
  '#uri': image_uri,
} %}

<div class="pcard" style="background-color: {{ shade_color|e('html_attr') }}; height: {{ height|e('html_attr') }};">

  <div class="pcard-image">
    {% if image %}
      {% if link %} <a href="{{ link }}"> {% endif %}

      <span style="display: inline-block; max-height: 300px; overflow: hidden;">
        {{ styled_media }}
      </span>

      {% if link %} </a> {% endif %}
    {% endif %}
  </div>

  <div>
    <h2><center>{{ title }}</center></h2>
    {{ content }}
  </div>
</div>