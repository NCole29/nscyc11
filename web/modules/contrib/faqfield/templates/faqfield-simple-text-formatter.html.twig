{#
/**
 * @file
 * Default theme implementation of a FAQ Field simple text formatter.
 *
 * Available variables:
 * - question: Pre-filtered question value by check_plain.
 * - answer: Pre-filtered answer value by field setting format.
 * - delta: Delta # of field element.
 *
 * @see template_preprocess()
 * @see template_preprocess_faqfield_simple_text_formatter()
 *
 * @ingroup themeable
 */
#}
{% set tag = question_tag ?: 'h3' %}
{% apply spaceless %}
  <{{ tag }} class="faqfield-question">{{ question }}</{{ tag }}>
  <div class="faqfield-answer">{{ answer }}</div>
{% endapply %}
