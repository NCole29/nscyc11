{# border_color and shade_colors are set in Appearance > NSC theme
   and made available to Twig via a preprocess hook in nsctheme.theme 
#}

{% set bg_color = paragraph.field_shaded_background.value ? shade_color: '#ffffff' %}
{% set bg_border = paragraph.field_border.value ? border_color : bg_color %}
{% set height = paragraph.field_full_height.value ? '100%': 'auto' %}

{{ include('nsctheme:pcallout', {
  shade_color: bg_color,
  border: bg_border,
  height: height, 
  heading: paragraph.field_title.value,
  content: content|without(content.field_title)
}, with_context = false) }}
