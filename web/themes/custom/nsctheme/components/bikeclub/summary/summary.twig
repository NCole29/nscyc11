
{# set minhgt =140 to account for thumbnails, and 230 if date & location are displayed above thumbnail #}
{% if date %}
  {% set minhgt = '230px' %}
{% else %}
  {% set minhgt = '140px' %}
{% endif %}
{#  style="min-height:{{ minhgt }}" #}


<article class="summary">
  <div class="summary-inner">

    <h2><a href="{{ url }}">{{ heading }}</a></h2>
    {% if image %}
    <div class="summary-image">{{ image }}</div>
    {% endif %}
    {# Events displayed in 2 columns #}
    {% if date or location %}
    <div class="summary-date">
      <div class="summary-date">
        {{ date }}
        {{ location }}
      </div>
      <div class="summary-text">
        {{ summary }}
      </div>
    </div>
    {% else %}
    {# Announcements and Basic Pages displayed in 1 column #}
    <div>
      {{ summary }}
    </div>
    {% endif %}
  </div>
</article>
