<?php

/**
 * @file
 * Defines a field for frequently asked questions.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\faqfield\Hook\FaqfieldHooks;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\field\FieldStorageConfigInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function faqfield_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(FaqfieldHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function faqfield_theme() {
  return \Drupal::service(FaqfieldHooks::class)->theme();
}

/**
 * Implements hook_preprocess_HOOK() for faqfield_simple_text_formatter.
 */
#[LegacyHook]
function faqfield_preprocess_faqfield_simple_text_formatter(array &$variables) {
  \Drupal::service(FaqfieldHooks::class)->preprocessSimpleText($variables);
}

/**
 * Implements hook_preprocess_HOOK() for faqfield_details_formatter.
 */
#[LegacyHook]
function faqfield_preprocess_faqfield_details_formatter(array &$variables) {
  \Drupal::service(FaqfieldHooks::class)->preprocessDetails($variables);
}

/**
 * Implements hook_preprocess_HOOK() for faqfield_definition_list_formatter.
 */
#[LegacyHook]
function faqfield_preprocess_faqfield_definition_list_formatter(array &$variables) {
  \Drupal::service(FaqfieldHooks::class)->preprocessDefinitionList($variables);
}

/**
 * Implements hook_preprocess_HOOK() for faqfield_anchor_list_formatter.
 */
#[LegacyHook]
function faqfield_preprocess_faqfield_anchor_list_formatter(array &$variables) {
  \Drupal::service(FaqfieldHooks::class)->preprocessAnchorList($variables);
}

/**
 * Implements hook_preprocess_HOOK() for faqfield_jquery_accordion_formatter.
 */
#[LegacyHook]
function faqfield_preprocess_faqfield_jquery_accordion_formatter(array &$variables) {
  \Drupal::service(FaqfieldHooks::class)->preprocessJqueryAccordion($variables);
}

/**
 * Implements hook_field_storage_config_create().
 *
 * Set the default cardinality to unlimited after a faqfield was created.
 */
#[LegacyHook]
function faqfield_field_storage_config_create(FieldStorageConfigInterface $field_storage) {
  \Drupal::service(FaqfieldHooks::class)->fieldStorageConfigCreate($field_storage);
}
