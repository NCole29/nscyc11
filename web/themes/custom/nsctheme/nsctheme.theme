<?php

/**
 * @file
 * Add your custom theme override functions here.
 */

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function nsctheme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  foreach ($suggestions as $key => $suggestion) {
    $suggestions[$key] = str_replace('solo_', 'nsctheme_', $suggestion);
  }
}

